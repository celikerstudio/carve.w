# Kopieer dit bestand naar `.env.local` en vul aan. Alles wat leeg blijft schakelt de
# bijbehorende functie uit; niets valt om door een ontbrekende sleutel.
#
# De admin-cockpit zegt zelf welke variabele mist: een bron zonder sleutel toont een blok
# met de namen erin in plaats van cijfers. Zie lib/admin/sources/source.ts.

# ─── Supabase: verplicht, zonder dit start er niets ────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen voor de scripts in scripts/ (wiki synchroniseren, quizvragen zaaien).
# @ai-gotcha: Niet gebruiken in app-code. De admin-cijfers draaien bewust op de anon key
# met de admin-sessie, want de RLS-policies laten dat toe via public.is_admin(). Deze
# sleutel omzeilt RLS volledig en is de voor de hand liggende verkeerde greep zodra een
# telling leeg terugkomt. Zie docs/tdr/0006-admin-is-de-cockpit.md, beslissing 6.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ──────────────────────────────────────────────────────────────────────
# Het publieke adres, met protocol en zonder slash aan het eind: https://carve.wiki
# Gebruikt door robots.txt, de sitemap, de metadata in app/layout.tsx en de
# verificatielink van de wachtlijst. Lokaal mag hier http://localhost:3000 staan.
NEXT_PUBLIC_SITE_URL=

# ─── Analytics op de site ──────────────────────────────────────────────────────
# GA4 → Beheer → Datastreams → je webstream. Vorm: G-XXXXXXXXXX.
# @ai-gotcha: Zonder dit laadt de gtag-tag niet en meet de site niets. Er staat bewust
# geen standaardwaarde in de code: een verkeerd ID vult stil de verkeerde property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Events Manager → je pixel. Alleen het nummer.
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Admin-cockpit: Meta ───────────────────────────────────────────────────────
# business.facebook.com → Bedrijfsinstellingen → Gebruikers → Systeemgebruikers →
# token genereren met `ads_read`, en met niets meer.
# @ai-gotcha: Controleer dat met `GET /debug_token`; de regel hierboven is een comment en
# geen controle. Draagt dit token ook `ads_management`, dan draait élke paginarender van de
# cockpit met een sleutel die campagnes kan pauzeren. Vervang hem dan, vóór de knoppen uit
# TDR-0011 aan gaan.
# @ai-gotcha: Neem een systeemgebruiker en geen persoonlijk token uit de Graph API
# Explorer. Dat laatste verloopt na een paar uur, of na 60 dagen als je het verlengt, en
# de Ads-tab staat dan stil zonder dat iets het meldt.
META_ACCESS_TOKEN=
# Het nummer uit de Ads Manager-URL. Met of zonder `act_` ervoor, de code zet hem erbij.
META_AD_ACCOUNT_ID=
# Tweede systeemgebruikerstoken, met `ads_management`. Alleen zetten waar de cockpit
# campagnes mag pauzeren en budgetten mag aanpassen (TDR-0011 beslissing 3).
# @ai-why: Bewust een aparte variabele en niet de scope van META_ACCESS_TOKEN erbij. Staat
# deze er niet, dan zijn de knoppen uit en blijft de Ads-tab gewoon lezen. Zet hem dus niet
# lokaal of op preview: daar test je niet mee tegen een echt advertentieaccount.
META_WRITE_TOKEN=

# ─── Admin-cockpit: GA4 Data API ───────────────────────────────────────────────
# GA4 → Beheer → Property-instellingen. Alleen het nummer.
GA4_PROPERTY_ID=
# Google Cloud Console → IAM → Serviceaccounts → sleutel toevoegen → JSON. Uit dat
# bestand komen `client_email` en `private_key`.
# @ai-gotcha: Voeg dat e-mailadres daarna toe als Lezer in GA4 → Beheer →
# Toegangsbeheer. Doe je dat niet, dan geeft Google `invalid_grant` en zegt de fout
# niets over de oorzaak.
GA4_CLIENT_EMAIL=
# Meerregelig. Tussen dubbele quotes, met \n in plaats van echte regeleindes.
GA4_PRIVATE_KEY=""

# ─── Admin-cockpit: App Store Connect ──────────────────────────────────────────
# App Store Connect → Gebruikers en toegang → Integraties → App Store Connect API →
# teamsleutel aanmaken. Het .p8-bestand krijg je één keer aangeboden.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
# De inhoud van het .p8-bestand. Zelfde vorm als GA4_PRIVATE_KEY hierboven.
APPSTORE_PRIVATE_KEY=""
# App Store Connect → Betalingen en financiële rapporten, linksboven.
APPSTORE_VENDOR_NUMBER=
# Het app-id staat bewust niet hier maar in lib/utils.ts (APP_STORE_ID). Het verschilt
# niet per omgeving, en twee plekken voor hetzelfde nummer is hoe het vorige keer fout
# ging.

# ─── Campagnes in de App Store-link ────────────────────────────────────────────
# App Store Connect → App Analytics → Acquisitie → Campagnes → campagnelink genereren.
# De waarde achter `pt=` in die link.
# @ai-why: Zolang dit leeg is, laat de code Apple's `ct` weg uit de downloadlinks. Een
# `ct` zonder `pt` koppelt Apple niet aan een campagne, en dan krijg je een link die
# eruitziet alsof hij meet terwijl er niets binnenkomt.
# @ai-sync: lib/app-store-link.ts
# @ai-sync: docs/tdr/0009-campagnerendement-komt-uit-ga4.md
NEXT_PUBLIC_APPSTORE_PROVIDER_TOKEN=

# ─── Overig ────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile, voor het aanmeldformulier. Alleen actief in productie.
TURNSTILE_SECRET_KEY=
# Alleen voor scripts/generate-quiz-questions.ts.
ANTHROPIC_API_KEY=

# ─── Feature flags ─────────────────────────────────────────────────────────────
# Aan in development, uit in productie. Zet op `true` om een domein op een deploy toch
# te tonen. Dit is geen beveiliging: NEXT_PUBLIC_* staat in de client-bundle.
# @ai-sync: lib/flags.ts
NEXT_PUBLIC_SHOW_MONEY=
NEXT_PUBLIC_SHOW_LIFE=
NEXT_PUBLIC_SHOW_WIKI=
